+  private obtenerTipoPermiso(
+    solicitud: Solicitud
+  ): string {
+
+    const tipo =
+      solicitud.nom_tipo_solicitud
+        .toLowerCase();
+
+
+    if (
+      tipo.includes('permiso personal')
+    ) {
+
+      return 'permiso personal';
+
+    }
+
+
+    if (
+      tipo.includes('permiso oficial')
+    ) {
+
+      return 'permiso oficial';
+
+    }
+
+
+    return 'permiso';
+
+  }
